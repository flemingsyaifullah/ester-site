---
import Layout from "../layouts/Layout.astro";
import portfolio3Data from "../data/portfolio3.json";

const items = (portfolio3Data as any[]).filter((p) => !p.suspended);
---
<Layout
  title="Portofolio Proyek | Ester Globalindo"
  description="Portofolio case study proyek pengurusan PBG dan SLF oleh Ester Globalindo di Jawa Timur."
  path="/portofolio-3"
>
  <!-- HERO -->
  <section class="border-b border-line bg-[#5b7ec5] text-paper">
    <div class="blueprint-grid">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <p class="font-mono text-xs uppercase tracking-widest text-paper/90">Portofolio</p>
        <h1 class="mt-2 max-w-2xl text-balance font-display text-4xl font-bold leading-tight sm:text-5xl">
          Proyek yang Telah Kami Tangani
        </h1>
        <p class="mt-4 max-w-xl font-body text-paper/90 leading-relaxed">
          Kepercayaan klien adalah pencapaian terbaik kami. Berikut sebagian proyek pengurusan PBG
          dan SLF yang telah berhasil kami selesaikan.
        </p>
      </div>
    </div>
  </section>

  <!-- LIST -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {items.map((p: any) => (
          <article class="relative rounded-sm border border-line bg-paper p-6 pt-8">
            <span class="absolute -top-3.5 left-5 rounded-sm border border-line bg-paper px-2.5 py-0.5 font-body text-sm font-bold text-ink">
              {p.jenis}
            </span>
            {p.foto && (
              <div class="mb-6 overflow-hidden rounded-sm border border-line">
                <img
                  src={p.foto}
                  alt={p.fotoAlt || p.jenis}
                  class="h-64 w-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            {p.luas && (
              <p class="font-body text-sm text-slate">{p.luas}</p>
            )}
            <p class="font-body text-sm text-slate">
              {p.lokasi}{p.tahun ? ` · ${p.tahun}` : ''}
            </p>
            {p.narasi && (
              <p class="mt-4 font-body text-sm leading-relaxed text-slate">{p.narasi}</p>
            )}
            {p.hasil && (
              <p class="mt-4 flex items-center gap-1.5 font-body text-sm font-bold text-green-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd"/></svg>
                {p.hasil}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import posts from "../../../data/blog.json";

export function getStaticPaths() {
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const title = (post as any).title_zh || post.title;
const excerpt = (post as any).excerpt_zh || post.excerpt;
const contentZh = (post as any).content_zh;
const content = (contentZh && contentZh.length > 0) ? contentZh : post.content;
const waNumber = "6282230027878";
const waMsg = encodeURIComponent(`您好，我刚读了 "${title}" 这篇文章，想进一步咨询。`);
const lainnya = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

function isFullHtmlPage(para: string): boolean {
  const tl = para.trim().toLowerCase();
  return tl.startsWith('<!doctype') || tl.startsWith('<html')
    || tl.includes('</body>') || tl.includes('</html>');
}

function buildSrcdoc(para: string): string {
  const t = para.trim();
  const tl = t.toLowerCase();
  const noScroll = '<style>html::-webkit-scrollbar{display:none}html{scrollbar-width:none}</style>';
  if (tl.startsWith('<!doctype') || tl.startsWith('<html')) {
    return t.replace(/<\/head>/i, `${noScroll}</head>`);
  }
  const styleTags = [...t.matchAll(/<style[^>]*>[\s\S]*?<\/style>/gi)].map(m => m[0]).join('');
  const linkTags  = [...t.matchAll(/<link[^>]*>/gi)].map(m => m[0]).join('');
  const bodyMatch = t.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
  const body = bodyMatch ? bodyMatch[1]
    : t.replace(/<link[^>]*>/gi, '').replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '').trim();
  return `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">${linkTags}${styleTags}${noScroll}</head><body>${body}</body></html>`;
}
---
<Layout
  title={`${title} | Ester Globalindo`}
  description={excerpt}
  path={`/zh-cn/blog/${post.slug}`}
>
  <article class="bg-paper">
    <div class="border-b border-line bg-[#5b7ec5] text-paper">
      <div class="blueprint-grid">
        <div class="mx-auto max-w-3xl px-5 py-14">
          <a href="/zh-cn/blog" class="font-mono text-xs uppercase tracking-wider text-paper/90 hover:text-white">&larr; 返回文章列表</a>
          <p class="mt-4 font-mono text-xs uppercase tracking-wider text-paper/90">
            {new Date(post.date).toLocaleDateString("zh-CN", { day: "numeric", month: "long", year: "numeric" })} &middot; {post.readTime}
          </p>
          <h1 class="mt-2 text-balance font-display text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
        </div>
      </div>
    </div>

    {content.map((para: string) => (
      isFullHtmlPage(para) ? (
        <iframe
          srcdoc={buildSrcdoc(para)}
          class="art-iframe w-full border-0 block"
          scrolling="no"
          style="min-height:900px;display:block"
          title="Konten artikel"
        />
      ) : para.trim().startsWith('<') ? (
        <div class="mx-auto max-w-3xl px-5 py-5">
          <div set:html={para} />
        </div>
      ) : (
        <p class="mx-auto max-w-3xl px-5 py-2 font-body text-base leading-relaxed text-ink">{para}</p>
      )
    ))}
  </article>

  <section class="border-t border-line bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-14">
      <p class="font-mono text-xs uppercase tracking-widest text-stamp">更多文章</p>
      <div class="mt-6 grid gap-4">
        {lainnya.map((p) => (
          <a href={`/zh-cn/blog/${p.slug}`} class="rounded-sm border border-ink bg-paper px-5 py-4 transition-shadow hover:shadow-md">
            <h3 class="font-display font-bold text-ink">{(p as any).title_zh || p.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  function resizeIframe(iframe: HTMLIFrameElement) {
    try {
      const h = iframe.contentDocument?.documentElement?.scrollHeight
        || iframe.contentDocument?.body?.scrollHeight;
      if (h && h > 100) iframe.style.height = h + 'px';
    } catch (_) {}
  }
  document.querySelectorAll('iframe.art-iframe').forEach((el) => {
    const iframe = el as HTMLIFrameElement;
    iframe.addEventListener('load', () => {
      resizeIframe(iframe);
      setTimeout(() => resizeIframe(iframe), 800);
      setTimeout(() => resizeIframe(iframe), 2000);
    });
  });
</script>
---
import Layout from "../../layouts/Layout.astro";
import posts from "../../data/blog.json";

export function getStaticPaths() {
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const waNumber = "6282230027878";
const waMsg = encodeURIComponent(`Halo, saya baru baca artikel "${post.title}" dan ingin konsultasi lebih lanjut.`);
const lainnya = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

function isFullHtmlPage(para: string): boolean {
  const tl = para.trim().toLowerCase();
  return tl.startsWith('<!doctype') || tl.startsWith('<html')
    || tl.includes('</body>') || tl.includes('</html>');
}

function processContent(para: string): string {
  const t = para.trim();
  
  // Extract all <style> blocks and scope :root to :host, and body to .shadow-body
  const styleTags = [...t.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/gi)].map(m => {
    let css = m[1];
    css = css.replace(/:root/gi, ':host');
    css = css.replace(/\bbody\s*\{/gi, '.shadow-body {');
    return `<style>${css}</style>`;
  }).join('');
  
  const linkTags = [...t.matchAll(/<link[^>]*>/gi)].map(m => m[0]).join('');
  
  // Extract <body> inner content
  const bodyMatch = t.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
  let body = bodyMatch ? bodyMatch[1] : t.replace(/<link[^>]*>/gi, '').replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '').trim();
  
  return `${linkTags}${styleTags}<div class="shadow-body">${body}</div>`;
}
---
<Layout
  title={`${post.title} | Artikel Ester Globalindo`}
  description={post.excerpt}
  path={`/blog/${post.slug}`}
>
  <article class="bg-paper">
    <div class="border-b border-line bg-[#5b7ec5] text-paper">
      <div class="blueprint-grid">
        <div class="mx-auto max-w-3xl px-5 py-14">
          <a href="/blog" class="font-mono text-xs uppercase tracking-wider text-paper/90 hover:text-white">&larr; Kembali ke Artikel</a>
          <p class="mt-4 font-mono text-xs uppercase tracking-wider text-paper/90">
            {new Date(post.date).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })} &middot; {post.readTime}
          </p>
          <h1 class="mt-2 text-balance font-display text-3xl font-bold leading-tight sm:text-4xl">{post.title}</h1>
        </div>
      </div>
    </div>

    {post.content.map((para) => (
      isFullHtmlPage(para) ? (
        <shadow-article class="block w-full">
          <template>
            <div set:html={processContent(para)} />
          </template>
        </shadow-article>
      ) : para.trim().startsWith('<') ? (
        <div class="mx-auto max-w-3xl px-5 py-5">
          <div set:html={para} />
        </div>
      ) : (
        <p class="mx-auto max-w-3xl px-5 py-2 font-body text-base leading-relaxed text-ink">{para}</p>
      )
    ))}
  </article>

  <section class="border-t border-line bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-14">
      <p class="font-mono text-xs uppercase tracking-widest text-stamp">Artikel lain</p>
      <div class="mt-6 grid gap-4">
        {lainnya.map((p) => (
          <a href={`/blog/${p.slug}`} class="rounded-sm border border-ink bg-paper px-5 py-4 transition-shadow hover:shadow-md">
            <h3 class="font-display font-bold text-ink">{p.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  class ShadowArticle extends HTMLElement {
    connectedCallback() {
      if (!this.shadowRoot) {
        const shadow = this.attachShadow({ mode: 'open' });
        const template = this.querySelector('template');
        if (template) {
          shadow.appendChild(template.content.cloneNode(true));
        }
      }
    }
  }
  if (!customElements.get('shadow-article')) {
    customElements.define('shadow-article', ShadowArticle);
  }
</script>